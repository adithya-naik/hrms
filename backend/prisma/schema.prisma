generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  auth0Id        String?        @unique
  email          String         @unique
  firstName      String
  lastName       String
  employeeId     String         @unique
  role           UserRole       @default(EMPLOYEE)
  managerId      String?
  departmentId   String?
  isActive       Boolean        @default(true)
  joinDate       DateTime       @default(now())
  profileImage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  password       String
  username       String         @unique
  hrId           String?
  auditLogs      AuditLog[]
  leaveBalances  LeaveBalance[]
  approvedLeaves Leave[]        @relation("LeaveApprover")
  leaveRequests  Leave[]        @relation("LeaveRequester")
  notifications  Notification[]
  department     Department?    @relation(fields: [departmentId], references: [id])
  hr             User?          @relation("HREmployee", fields: [hrId], references: [id])
  hrEmployees    User[]         @relation("HREmployee")
  manager        User?          @relation("ManagerEmployee", fields: [managerId], references: [id])
  employees      User[]         @relation("ManagerEmployee")
  projects       Project[]
  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  headId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("departments")
}

model LeavePolicy {
  id                  String         @id @default(cuid())
  leaveType           LeaveType      @unique
  annualQuota         Int
  monthlyQuota        Int            // NEW
  quotaResetDay       Int            @default(1) // NEW
  maxConsecutiveDays  Int?
  minDaysNotice       Int            @default(1)
  requiresApproval    Boolean        @default(true)
  requiresDocument    Boolean        @default(false)
  carryForwardAllowed Boolean        @default(false)
  maxCarryForward     Int?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  leaveBalances       LeaveBalance[] @relation("LeavePolicyToBalances")
  leaves              Leave[]        @relation("LeavePolicyToLeaves")

  @@map("leave_policies")
}


model Leave {
  id               String           @id @default(cuid())
  requesterId      String
  approverId       String?
  leaveType        LeaveType
  startDate        DateTime
  endDate          DateTime
  totalDays        Float
  reason           String
  status           LeaveStatus      @default(PENDING)
  appliedDate      DateTime         @default(now())
  approvedDate     DateTime?
  rejectionReason  String?
  attachments      String[]         @default([])
  isHalfDay        Boolean          @default(false)
  emergencyLeave   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  isLOP            Boolean          @default(false)
  leavePolicyId    String?
  lastReminderSent DateTime?
  dayStatuses      LeaveDayStatus[]
  approver         User?            @relation("LeaveApprover", fields: [approverId], references: [id])
  leavePolicy      LeavePolicy?     @relation("LeavePolicyToLeaves", fields: [leavePolicyId], references: [id], onDelete: Cascade)
  requester        User             @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model LeaveDayStatus {
  id      String      @id @default(cuid())
  leaveId String
  date    DateTime
  status  LeaveStatus @default(PENDING)
  reason  String?
  leave   Leave       @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@unique([leaveId, date])
  @@map("leave_day_statuses")
}

model LeaveBalance {
  id            String      @id @default(cuid())
  userId        String
  leavePolicyId String
  year          Int
  month         Int         // NEW
  totalQuota    Int
  usedDays      Float       @default(0)
  pendingDays   Float       @default(0)
  availableDays Float
  carryForward  Float       @default(0)
  resetDate     DateTime    // NEW
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  leavePolicy   LeavePolicy @relation("LeavePolicyToBalances", fields: [leavePolicyId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leavePolicyId, year, month])
  @@map("leave_balances")
}

model Holiday {
  id          String   @id @default(cuid())
  name        String   @unique
  date        DateTime
  description String?
  isRecurring Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("holidays")
}


model Project {
  id             String   @id @default(cuid())
  projectName    String
  clientName     String
  revenue        Float?
  managerId      String
  priority       String
  allocatedHours Int?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager        User     @relation(fields: [managerId], references: [id])
}

model Setting {
  id           String   @id @default(cuid())
  companyName  String
  logoUrl      String?
  address      String?
  contactEmail String?
  contactPhone String?
  timezone     String
  currency     String
  dateFormat   String
  timeFormat   String
  language     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  leaveId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

enum LeaveType {
  SICK
  CASUAL
  WFH
  LOP
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PARTIAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CANCEL
}
